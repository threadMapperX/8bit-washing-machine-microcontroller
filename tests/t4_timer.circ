    <comp lib="8" loc="(60,30)" name="Text">
      <a name="text" val="PIPELINE CONTROL (stall / flush / halt)"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif bold 16"/>
    </comp>
    <comp lib="8" loc="(60,60)" name="Text">
      <a name="text" val="kill = taken | halt_ex  (flush IF/ID and ID/EX) ; flush has priority over a younger stall"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="8" loc="(60,90)" name="Text">
      <a name="text" val="stall_eff = stall &amp; ~kill ; PC/IF-ID freeze on stall_eff ; ID/EX gets a bubble"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
