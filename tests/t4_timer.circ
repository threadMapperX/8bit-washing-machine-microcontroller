    <comp lib="8" loc="(60,30)" name="Text">
      <a name="text" val="SAFETY INTERLOCK (hardware)"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif bold 16"/>
    </comp>
    <comp lib="8" loc="(60,60)" name="Text">
      <a name="text" val="motor_actual = motor_req &amp; door_closed &amp; ~trip   (purely combinational door gate)"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="8" loc="(60,90)" name="Text">
      <a name="text" val="TRIP &lt;= set | (TRIP &amp; ~rearm) ; set = motor_req &amp; ~door_closed (sampled on CLK)"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="8" loc="(60,120)" name="Text">
      <a name="text" val="rearm = TRIP &amp; ~motor_req &amp; door_closed &amp; START rising edge (start &amp; ~start_prev)"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
