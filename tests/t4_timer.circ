      <circ-port dir="in" height="8" pin="120,240" width="8" x="46" y="96"/>
      <text dominant-baseline="central" fill="#000000" font-family="SansSerif" font-size="8" text-anchor="start" x="56" y="123">sub</text>
      <circ-port dir="in" height="8" pin="120,280" width="8" x="46" y="116"/>
      <text dominant-baseline="central" fill="#000000" font-family="SansSerif" font-size="8" text-anchor="end" x="134" y="63">r</text>
      <circ-port dir="out" height="10" pin="890,160" width="10" x="135" y="55"/>
