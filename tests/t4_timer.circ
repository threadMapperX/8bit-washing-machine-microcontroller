    <comp lib="8" loc="(60,30)" name="Text">
      <a name="text" val="ALU8"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif bold 16"/>
    </comp>
    <comp lib="8" loc="(60,60)" name="Text">
      <a name="text" val="op: 00 = x + (y^sub) + sub   01 = x AND y   10 = pass y   11 = SLTU {7'b0, ~cout}"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="8" loc="(60,90)" name="Text">
      <a name="text" val="SUB/SLTU set sub=1: x + ~y + 1, so cout = 1 exactly when x &gt;= y (unsigned)"/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
