      <a name="text" val="Ticks on every rising CLK edge, independent of CPU stall/halt.  CTRL write: bit0 = EN, bit1 = CLR (pulse)."/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
    <comp lib="8" loc="(60,90)" name="Text">
      <a name="text" val="clr has priority: COUNT&lt;=0, MATCH&lt;=0.  Else if EN: COUNT&lt;=COUNT+1 and MATCH |= (COUNT+1 == LIMIT != 0)."/>
      <a name="halign" val="left"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>
