      <text dominant-baseline="alphabetic" fill="#404040" font-family="SansSerif" font-size="10" font-weight="bold" text-anchor="middle" x="95" y="46">ALU8</text>
      <text dominant-baseline="central" fill="#000000" font-family="SansSerif" font-size="8" text-anchor="start" x="56" y="63">x</text>
      <circ-port dir="in" height="8" pin="120,160" width="8" x="46" y="56"/>
      <text dominant-baseline="central" fill="#000000" font-family="SansSerif" font-size="8" text-anchor="start" x="56" y="83">y</text>
      <circ-port dir="in" height="8" pin="120,200" width="8" x="46" y="76"/>
